{
  "dependencies": {
    "croner": "^10.0.1",
    "discord-api-types": "^0.38.54",
    "discord.js": "^14.27.0",
    "eventsource-parser": "^4.1.0",
    "fuse.js": "^7.5.0",
    "posthog-node": "^5.51.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-imperium": "^4.1.4",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "name": "finki-hub-discord-bot",
  "private": true,
  "scripts": {
    "build": "npm run clean && node esbuild.config.js && tsc-alias",
    "check": "tsc --noEmit",
    "clean": "rimraf dist",
    "dev": "tsx src/index.ts",
    "format": "eslint . --cache --fix",
    "lint": "eslint . --cache",
    "start": "node dist/index.js",
    "start:env": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "0.0.0"
}
